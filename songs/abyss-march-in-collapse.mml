; "No Coming Back" (collapse march cut) - 60 bpm, 4/4, 35 bars (~2:20), D minor
; Same dialect as keynote.mml.
; I   realization  1-8    lone piano, strings creep in at 5        i VI iv V x2
; II  the abyss    9-16   cello takes the theme, bell tolls, choir at 13
; III collapse    17-24   i bII i bII / VI iv V V - the Neapolitan Eb is the floor giving way
;                         funeral snare marching over palm-muted guitar + kick locked on a 3+3+2 sixteenth pattern underneath
; IV  impact         25
; V   lament      26-35   piano almost alone over a fading D-A drone. The drone leaves
;                         before the last note, and the last note is the 9th. It never gets home.

#tempo 60
#transpose 0
#humanize 6

; piano left hand, one bar of rising broken chord
$LDm = l8 [o2 d a o3 d f]2
$LBb = l8 [o1 b- o2 f b- o3 d]2
$LGm = l8 [o2 g o3 d g b-]2
$LA  = l8 [o2 a o3 e a o4 c+]2

; string / choir chords
$sDm = o3 {d a >d f}1
$sBb = o3 {d f b- >d}1
$sGm = o3 {d g b- >d}1
$sA  = o3 {c+ e a >c+}1
$sEb = o3 {e- g b- >e-}1

$cDm = o4 {d f a}1
$cBb = o4 {d f b-}1
$cGm = o4 {d g b-}1
$cA  = o4 {c+ e a}1
$cEb = o4 {e- g b-}1

; funeral snare figure: a roll on 1, then the dotted tap (tuba/march macros below are unused in this cut)
$tDm = l4 o2 d r o1 a r
$tGm = l4 o1 g r o2 d r
$tBb = l4 o1 b- r o2 f r
$tA  = l4 o1 a r o2 e r
$BD  = l4 n35 r n35 r
$SN  = l16 n38 n38 n38 n38 l8. n38 l16 n38 l4 n38 r

; collapse guitar: palm-muted power chords, 8 sixteenths accented 3+3+2, twice per bar.
; Each hit is a dotted 32nd plus a 64th rest, which is the palm mute. Double-tracked:
; distortion on ch13, overdrive on ch14.
$pD  = o2 {d a}32. r64
$pEb = o2 {e- b-}32. r64
$pBb = o2 {b- >f}32. r64
$pG  = o2 {g >d}32. r64
$pA  = o2 {a >e}32. r64
$gDm = [v124 $pD v92 $pD $pD v124 $pD v92 $pD $pD v124 $pD v92 $pD]2
$gEb = [v124 $pEb v92 $pEb $pEb v124 $pEb v92 $pEb $pEb v124 $pEb v92 $pEb]2
$gBb = [v124 $pBb v92 $pBb $pBb v124 $pBb v92 $pBb $pBb v124 $pBb v92 $pBb]2
$gGm = [v124 $pG v92 $pG $pG v124 $pG v92 $pG $pG v124 $pG v92 $pG]2
$gA  = [v124 $pA v92 $pA $pA v124 $pA v92 $pA $pA v124 $pA v92 $pA]2
; the bass drum on the same 3+3+2 accents
$KC  = l16 [n36 r r n36 r r n36 r]2

@track lead ch=1 prog=0 v=72 rev=75 pan=64
o5 a2 g4 f4   f2. d4   d2 c4 <b-4>   o4 a1
o5 a2 g4 f4   f2 g4 a4   b-2 a4 g4   c+1
l1 [r]16
v112 o4 {d a >d f a}1
v58 o5 a2. g4   f2 e4 d4   e2. f8 e8   o4 a1
v54 o5 r4 f4 a4 >d4   c2. <b-4   v48 a2 g4 f4   v42 e1
l1 [r]2

